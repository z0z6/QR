{
  "name": "qr-transmisja",
  "productName": "QR",
  "version": "1.0.1",
  "description": "Generator kodów QR i przesyłanie plików ruchomym kodem QR (Windows, Linux, macOS, Android, przeglądarka)",
  "main": "src/main/main.js",
  "author": "projektnumer4",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.js",
    "dist:win": "electron-builder --win portable --publish never",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "dist:mac": "electron-builder --mac dmg --arm64 --x64 --publish never",
    "web": "node scripts/build-web.js",
    "android:sync": "cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "pl.projektnumer4.qr",
    "productName": "QR",
    "artifactName": "QR-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/**"
    ],
    "afterPack": "build/afterPack.js",
    "linux": {
      "target": [
        "AppImage"
      ],
      "executableName": "qr-transmisja",
      "icon": "build/icon.png",
      "category": "Utility",
      "synopsis": "Generator kodów QR i transmisja plików",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "QR-${version}-portable.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSCameraUsageDescription": "Aparat służy do odczytywania kodów QR i odbierania transmisji z ekranu innego urządzenia."
      }
    },
    "dmg": {
      "artifactName": "QR-${version}-mac-${arch}.dmg"
    }
  },
  "desktopName": "qr-transmisja.desktop"
}
